{
  "name": "lrs-backend",
  "version": "0.1.3",
  "private": true,
  "description": "證照報名系統 (LRS) 重構 - Node.js + Express 後端",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src --watch-path=.env src/server.js",
    "db:check": "node scripts/check-db-connection.js",
    "test": "node --test test/*.test.js",
    "db:setup": "node scripts/setup-test-db.js",
    "db:inspect": "node scripts/inspect-legacy-schema.js",
    "db:copy-prod": "node scripts/copy-prod-to-test.js",
    "db:migrate-test": "node scripts/migrate-test-db.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "sequelize": "^6.37.8",
    "tedious": "^20.3.8"
  }
}
