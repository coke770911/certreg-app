# ==============================================================================
# 證照報名系統 (LRS) 環境變數設定檔
# ==============================================================================
# 本檔為唯一的環境設定檔，正式與測試參數皆收斂於此，透過 APP_ENV 單一開關切換。
# 本檔含資料庫密碼與金鑰，已列入 .gitignore，請勿提交至版本控制。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 系統運行模式控制 (單一開關切換)
# ------------------------------------------------------------------------------
# 可選值:
#   development -> 測試/開發模式 (連線至測試資料庫，允許 ORM 建表與除錯)
#   test        -> 自動化測試模式 (連線至測試資料庫，允許 ORM 建表，供單元/整合測試使用)
#   production  -> 正式上線模式 (連線至正式資料庫，強制鎖定禁止任何 DDL / Sync)
# 注意：未設定或填入其他值時，系統將拒絕啟動，不會自動套用預設值。
APP_ENV=development

# 應用程式服務通訊埠
PORT=3000

# ------------------------------------------------------------------------------
# 2. 正式資料庫連線設定 (Production DB - SQL Server 2014)
# 警告：此伺服器已正式上線運行中，嚴禁任何新增/修改/刪除表結構之行為！
# 僅於 APP_ENV=production 時使用。系統會在程式層攔截 sync() 與所有 DDL 指令，
# 但最根本的防護仍是：請改用僅具 db_datareader (必要時加 db_datawriter) 權限的帳號，
# 避免使用 sa 等系統管理員帳號。
# ------------------------------------------------------------------------------
# 正式資料庫主機位址 (IP 或主機名稱)
PROD_DB_HOST=127.0.0.1
# 正式資料庫通訊埠 (SQL Server 預設 1433)
PROD_DB_PORT=1433
# 正式資料庫名稱
PROD_DB_NAME=lrs_prod_db
# 正式資料庫登入帳號
PROD_DB_USER=sa
# 正式資料庫登入密碼
PROD_DB_PASSWORD=your_prod_secure_password_here

# ------------------------------------------------------------------------------
# 3. 測試資料庫連線設定 (Test / Development DB - SQL Server)
# 用途：供重構期間 ORM 自動建表 (sync)、假資料注入 (seed) 與單元測試使用
# 僅於 APP_ENV=development 或 test 時使用。
# 安全檢查：若「主機 + 通訊埠 + 資料庫名稱」與正式資料庫完全相同，系統將拒絕啟動，
# 以防止誤將測試設定指向正式資料庫而執行建表。
# ------------------------------------------------------------------------------
# 測試資料庫主機位址 (IP 或主機名稱)
TEST_DB_HOST=127.0.0.1
# 測試資料庫通訊埠 (SQL Server 預設 1433)
TEST_DB_PORT=1433
# 測試資料庫名稱
TEST_DB_NAME=lrs_test_db
# 測試資料庫登入帳號
TEST_DB_USER=sa
# 測試資料庫登入密碼
TEST_DB_PASSWORD=your_test_secure_password_here

# ------------------------------------------------------------------------------
# 4. JWT 身分驗證與安全性金鑰
# ------------------------------------------------------------------------------
# JWT 簽章金鑰：正式環境務必更換為 32 字元以上的隨機字串
JWT_SECRET=your_jwt_secret_key_change_me_in_production
# JWT 有效期限 (格式如 30m、12h、7d)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 5. 前端 CORS 白名單設定 (Vue 3 開發伺服器與正式網址)
# ------------------------------------------------------------------------------
# 允許跨來源存取的前端網址，多筆以半形逗號分隔，不可含空白與結尾斜線
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. 資料庫連線進階選項 (正式與測試資料庫共用)
# ------------------------------------------------------------------------------
# 是否以 TLS 加密連線 (true / false)
# SQL Server 2014 若未安裝 TLS 1.2 更新，請維持 false，否則可能無法連線
DB_ENCRYPT=false
# 是否信任伺服器自簽憑證 (true / false)，內網自簽憑證環境請設為 true
DB_TRUST_SERVER_CERTIFICATE=true
# 是否於主控台輸出 SQL 語句 (true / false)；正式環境一律強制關閉
DB_LOGGING=true

# ------------------------------------------------------------------------------
# 7. 登入驗證設定
# ------------------------------------------------------------------------------
# 登入方式 (留空則依 APP_ENV 自動決定：production -> ad，其餘 -> dev)
#   ad  -> 呼叫學校 AD 驗證服務驗證帳號密碼 (正式環境強制使用)
#   dev -> 開發用登入：帳號存在於 v_UserData 即可用任意密碼登入，僅限測試資料庫
AUTH_PROVIDER=
# 學校 AD 驗證服務 (SOAP) 網址
AD_AUTH_URL=https://your-school-ad-service/auth.asmx
# AD 驗證服務的 XML 命名空間 (WSDL 中的 targetNamespace)
AD_AUTH_NAMESPACE=LDAP://your-ad-namespace
# 註：可代理學生登入的管理員帳號 (舊 ADMIN_ACCOUNTS) 已改由管理端「權限設定」頁維護，
#     不再於本檔設定。若本檔仍保留 ADMIN_ACCOUNTS，首次啟動時會一次性匯入權限設定後即不再讀取。

# ------------------------------------------------------------------------------
# 8. 部署設定
# ------------------------------------------------------------------------------
# 部署於 IIS / Nginx 等反向代理之後時設定 (例如 loopback)，以取得正確的來源 IP 與 HTTPS 狀態；
# 直接對外提供服務時請留空
TRUST_PROXY=
# 本機資料目錄：存放系統日誌 (logs/，保留 365 天) 與管理端權限設定 (permissions.json)
# 正式資料庫禁止建表，這兩類資料改存伺服器本機檔案。留空則使用 backend/data
# 目錄內含帳號與來源 IP，已列入 .gitignore；請定期備份，並勿放在網站公開目錄
DATA_DIR=

# ------------------------------------------------------------------------------
# 9. 繳費單收款資訊 (印在學生列印的繳費單上)
# ------------------------------------------------------------------------------
# 收款戶名
PAY_ACCOUNT_NAME=your_account_name
# 收款帳號 14 碼 (單位別 3 碼 + 科目 3 碼 + 編號 7 碼 + 檢查碼 1 碼)
PAY_BANK_ACCOUNT=00000000000000
# 收款銀行名稱 (收據「需經 ○○ 加蓋收款戳記」)
PAY_BANK_NAME=your_bank_name
# 收款分行 (第一聯「○○分行收款留存」)
PAY_BANK_BRANCH=your_branch_name
